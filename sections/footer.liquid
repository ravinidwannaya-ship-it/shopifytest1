<footer class="footer">
  <div class="container">
    <div class="grid grid--4" style="--cols-mobile:1">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              {%- if settings.logo_light or settings.logo -%}
                <img src="{{ settings.logo_light | default: settings.logo | image_url: width: 480 }}" alt="{{ settings.brand_name | escape }}" width="200" height="70" style="width:{{ block.settings.logo_width }}px;margin-bottom:14px" loading="lazy">
              {%- else -%}<h3>{{ settings.brand_name }}</h3>{%- endif -%}
              <p style="font-size:.92rem;opacity:.9">{{ block.settings.text | default: settings.footer_tagline }}</p>
              <div class="social">
                {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">Instagram</a>{%- endif -%}
                {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="Facebook">Facebook</a>{%- endif -%}
                {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube">YouTube</a>{%- endif -%}
                {%- if settings.social_pinterest != blank -%}<a href="{{ settings.social_pinterest }}" aria-label="Pinterest">Pinterest</a>{%- endif -%}
                {%- if settings.social_x != blank -%}<a href="{{ settings.social_x }}" aria-label="X">X</a>{%- endif -%}
              </div>
            {%- when 'menu' -%}
              <h3>{{ block.settings.heading }}</h3>
              <ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul>
            {%- when 'contact' -%}
              <h3>{{ block.settings.heading }}</h3>
              <ul>
                {%- if settings.address != blank -%}<li>{{ settings.address }}</li>{%- endif -%}
                {%- if settings.hours != blank -%}<li>{{ settings.hours }}</li>{%- endif -%}
                {%- if settings.phone != blank -%}<li><a href="tel:{{ settings.phone | remove: ' ' }}"><strong>Call {{ settings.phone }}</strong></a></li>{%- endif -%}
                {%- if settings.whatsapp != blank -%}<li><a href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener">WhatsApp us</a></li>{%- endif -%}
                {%- if settings.email != blank -%}<li><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></li>{%- endif -%}
                {%- if settings.map_url != blank -%}<li><a href="{{ settings.map_url }}" target="_blank" rel="noopener">Get directions</a></li>{%- endif -%}
              </ul>
            {%- when 'newsletter' -%}
              <h3>{{ block.settings.heading }}</h3>
              <p style="font-size:.9rem;opacity:.9">{{ block.settings.text }}</p>
              {% form 'customer' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <input type="email" name="contact[email]" placeholder="Email address" required aria-label="Email address">
                <button type="submit" class="btn btn--accent btn--full" style="margin-top:8px">{{ block.settings.button_label }}</button>
                {%- if form.posted_successfully? -%}<p style="margin-top:8px">Thank you for subscribing.</p>{%- endif -%}
              {% endform %}
            {%- when 'text' -%}
              <h3>{{ block.settings.heading }}</h3>
              <div class="rte" style="font-size:.92rem">{{ block.settings.text }}</div>
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_extra }}</span>
      {%- if section.settings.show_payment_icons -%}<span>{{ shop.enabled_payment_types | payment_type_svg_tag: class: 'payment-icon' }}</span>{%- endif -%}
      {%- if section.settings.policy_menu != blank -%}
        <span>{% for link in section.settings.policy_menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% unless forloop.last %} &middot; {% endunless %}{% endfor %}</span>
      {%- endif -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "max_blocks": 6,
  "settings": [
    { "type": "link_list", "id": "policy_menu", "label": "Policy menu (bottom row)" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "copyright_extra", "label": "Extra copyright text", "default": "Handcrafted in Puttur, Karnataka." }
  ],
  "blocks": [
    { "type": "brand", "name": "Brand", "limit": 1, "settings": [
      { "type": "range", "id": "logo_width", "min": 80, "max": 300, "step": 10, "unit": "px", "label": "Logo width", "default": 170 },
      { "type": "textarea", "id": "text", "label": "Tagline" }
    ]},
    { "type": "menu", "name": "Menu", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
      { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
    ]},
    { "type": "contact", "name": "Contact", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Visit the studio" }
    ]},
    { "type": "newsletter", "name": "Newsletter", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
      { "type": "text", "id": "text", "label": "Text", "default": "New launches, festival drops and studio stories." },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
    ]},
    { "type": "text", "name": "Text", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Gold coated silver idols and framed deity reliefs.</p>" }
    ]}
  ]
}
{% endschema %}
