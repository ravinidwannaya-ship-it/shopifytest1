<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% endif %} text-center" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    {% render 'section-head' %}
    <div class="media ratio-landscape reveal">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1200x', controls: true, muted: section.settings.muted, autoplay: section.settings.autoplay, loop: section.settings.loop }}
      {%- elsif section.settings.video_url != blank -%}
        <iframe src="{{ section.settings.video_url | replace: 'watch?v=', 'embed/' }}" title="{{ section.settings.heading | escape }}" loading="lazy" allowfullscreen style="width:100%;height:100%;border:0"></iframe>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Video",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Inside the Puttur studio" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "video", "id": "video", "label": "Shopify-hosted video" },
    { "type": "text", "id": "video_url", "label": "Or YouTube / Vimeo embed URL" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "checkbox", "id": "muted", "label": "Muted", "default": true },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": true },
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "default", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
