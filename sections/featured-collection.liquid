{%- assign coll = collections[section.settings.collection] -%}
<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% endif %} {% if section.settings.text_align == 'center' %}text-center{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    {% render 'section-head' %}
    <div class="grid grid--{{ section.settings.columns }}" style="--cols-mobile:{{ section.settings.columns_mobile }}">
      {%- for product in coll.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <div class="pcard"><div class="pcard__media ratio-portrait">{{ 'product-1' | placeholder_svg_tag }}</div><div class="pcard__body"><h3 class="pcard__title">Example product</h3><p class="price">Rs 0</p></div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.show_view_all and coll != blank -%}
      <div style="margin-top:28px;text-align:center"><a class="btn btn--outline" href="{{ coll.url }}">{{ section.settings.view_all_label }}</a></div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most gifted this season" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "limit", "min": 2, "max": 24, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "2", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
    ]},
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "header", "content": "Style" },
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "default", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }
    ]},
    { "type": "select", "id": "text_align", "label": "Heading alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
