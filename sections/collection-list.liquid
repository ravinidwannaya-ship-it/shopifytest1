<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% endif %} {% if section.settings.text_align == 'center' %}text-center{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    {% render 'section-head' %}
    <div class="grid grid--{{ section.settings.columns }}" style="--cols-mobile:1">
      {%- for block in section.blocks -%}
        {%- assign c = collections[block.settings.collection] -%}
        <a class="reveal" href="{{ c.url | default: block.settings.link }}" {{ block.shopify_attributes }}>
          <div class="media ratio-{{ section.settings.ratio }}">
            {%- assign img = block.settings.image | default: c.featured_image -%}
            {%- if img -%}<img src="{{ img | image_url: width: 900 }}" alt="{{ block.settings.heading | default: c.title | escape }}" width="900" height="900" loading="lazy">{%- else -%}{{ 'collection-1' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <h3 style="margin-top:12px">{{ block.settings.heading | default: c.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="muted">{{ block.settings.text }}</p>{%- endif -%}
          <span class="link-underline">{{ block.settings.link_label | default: 'Explore' }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two things, made properly" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "select", "id": "ratio", "label": "Image ratio", "default": "portrait", "options": [
      { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }
    ]},
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "default", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }
    ]},
    { "type": "select", "id": "text_align", "label": "Heading alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    { "type": "item", "name": "Collection", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Custom image" },
      { "type": "text", "id": "heading", "label": "Custom title" },
      { "type": "text", "id": "text", "label": "Description" },
      { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
      { "type": "url", "id": "link", "label": "Custom link" }
    ]}
  ],
  "presets": [{ "name": "Collection list", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
