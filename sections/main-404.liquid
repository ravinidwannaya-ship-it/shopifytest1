<div class="section text-center" style="padding-block:100px">
  <div class="container container--narrow">
    <p class="eyebrow">404</p>
    <h1>{{ section.settings.heading }}</h1>
    <p class="muted">{{ section.settings.text }}</p>
    <a class="btn" href="{{ routes.root_url }}">{{ section.settings.button_label }}</a>
  </div>
</div>
{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has moved" },
    { "type": "text", "id": "text", "label": "Text", "default": "The page you were looking for is not here." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Back to home" }
  ]
}
{% endschema %}
