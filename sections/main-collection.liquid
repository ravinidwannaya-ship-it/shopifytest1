{%- paginate collection.products by section.settings.per_page -%}
<div class="section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    {%- if section.settings.show_banner -%}
      <div class="section__head" style="max-width:820px">
        <p class="eyebrow">Collection</p>
        <h1>{{ collection.title }}</h1>
        {%- if collection.description != blank -%}<div class="rte muted">{{ collection.description }}</div>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="collection-layout">
      <aside class="facets">
        {%- if section.settings.show_filters -%}
          <form data-facet-form method="get">
            {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}
            {%- for filter in collection.filters -%}
              <details open>
                <summary>{{ filter.label }}</summary>
                {%- case filter.type -%}
                  {%- when 'list' -%}
                    {%- for value in filter.values -%}
                      <label><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}> {{ value.label }} <span class="muted">({{ value.count }})</span></label>
                    {%- endfor -%}
                  {%- when 'price_range' -%}
                    <label>Min <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}"></label>
                    <label>Max <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}"></label>
                {%- endcase -%}
              </details>
            {%- endfor -%}
            {%- if collection.filters.size > 0 -%}<a class="link-underline" href="{{ collection.url }}" style="display:inline-block;margin-top:12px">Clear all</a>{%- endif -%}
          </form>
        {%- endif -%}
      </aside>
      <div>
        <div class="toolbar">
          <button type="button" class="btn btn--outline" data-facets-toggle style="display:none">Filter</button>
          <span class="muted">{{ collection.products_count }} products</span>
          {%- if section.settings.show_sort -%}
            <label style="display:flex;gap:8px;align-items:center"><span class="muted" style="font-size:.85rem">Sort</span>
              <select data-sort style="width:auto">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </label>
          {%- endif -%}
        </div>
        <div class="grid grid--{{ section.settings.columns }}" style="--cols-mobile:{{ section.settings.columns_mobile }}">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- else -%}
            <p class="muted">No products found.</p>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" aria-label="Pagination">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- else -%}<span class="{% if part.title == paginate.current_page %}current{% endif %}">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
<style>@media(max-width:989px){[data-facets-toggle]{display:inline-flex!important}}</style>
{%- endpaginate -%}
{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "checkbox", "id": "show_banner", "label": "Show collection title and description", "default": true },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sorting", "default": true },
    { "type": "range", "id": "per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "default": "2", "options": [
      { "value": "1", "label": "1" }, { "value": "2", "label": "2" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ]
}
{% endschema %}
