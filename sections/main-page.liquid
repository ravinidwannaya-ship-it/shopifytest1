<div class="section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="{% if section.settings.narrow %}container container--narrow{% else %}container{% endif %}">
    {%- if section.settings.show_title -%}<h1>{{ page.title }}</h1>{%- endif -%}
    <div class="rte">{{ page.content }}</div>
  </div>
</div>
{% schema %}
{
  "name": "Page content",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true },
    { "type": "checkbox", "id": "narrow", "label": "Narrow content width", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 56 }
  ]
}
{% endschema %}
