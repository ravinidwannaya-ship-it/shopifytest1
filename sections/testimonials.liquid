<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% endif %} {% if section.settings.text_align == 'center' %}text-center{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    {% render 'section-head' %}
    <div class="grid grid--{{ section.settings.columns }}" style="--cols-mobile:1">
      {%- for block in section.blocks -%}
        <figure class="quote reveal" style="margin:0" {{ block.shopify_attributes }}>
          <div class="stars" aria-label="{{ block.settings.rating }} out of 5">{% for i in (1..5) %}{% if i <= block.settings.rating %}&#9733;{% else %}&#9734;{% endif %}{% endfor %}</div>
          <blockquote class="quote__q" style="margin:10px 0">{{ block.settings.quote }}</blockquote>
          <figcaption style="display:flex;gap:10px;align-items:center">
            {%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 96 }}" alt="" width="44" height="44" loading="lazy" style="border-radius:99px;width:44px;height:44px;object-fit:cover">{%- endif -%}
            <span><strong>{{ block.settings.name }}</strong><br><span class="muted" style="font-size:.85rem">{{ block.settings.detail }}</span></span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "alt", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }
    ]},
    { "type": "select", "id": "text_align", "label": "Heading alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    { "type": "quote", "name": "Testimonial", "settings": [
      { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "The gold work is genuinely hand laid. Six months on, the silver has not dulled at all." },
      { "type": "text", "id": "name", "label": "Name", "default": "Meera Raghavan" },
      { "type": "text", "id": "detail", "label": "Detail", "default": "Chennai - Siddhi Ganesha Idol" },
      { "type": "image_picker", "id": "image", "label": "Photo" }
    ]}
  ],
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }] }]
}
{% endschema %}
