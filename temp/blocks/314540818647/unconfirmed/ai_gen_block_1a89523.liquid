{% doc %}
  @prompt
    Create a standalone logo section for a premium religious idol brand store. The section should include: an image picker for the logo, controls for logo width/height (desktop and mobile), alignment options (left, center, right), optional tagline text below the logo with font size and color controls, padding controls (top and bottom), background color picker, and a link field to make the logo clickable. The design should feel premium and heritage-luxury, suitable for a high-end Indian brand.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-logo-section__container-{{ ai_gen_id }} {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-logo-section__link-{{ ai_gen_id }} {
    display: inline-block;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .ai-logo-section__link-{{ ai_gen_id }}:hover {
    opacity: 0.85;
  }

  .ai-logo-section__image-wrapper-{{ ai_gen_id }} {
    display: inline-block;
    width: {{ block.settings.logo_width_desktop }}px;
    max-width: 100%;
  }

  .ai-logo-section__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-logo-section__placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #F3E9D7;
    border: 2px dashed #E4D8C4;
    border-radius: 4px;
    padding: 40px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .ai-logo-section__placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
    color: #7A6A5C;
  }

  .ai-logo-section__placeholder-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: #7A6A5C;
    font-style: italic;
  }

  .ai-logo-section__tagline-{{ ai_gen_id }} {
    margin-top: 12px;
    font-size: {{ block.settings.tagline_font_size }}px;
    color: {{ block.settings.tagline_color }};
    line-height: 1.5;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.6 | round }}px;
    }

    .ai-logo-section__image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
    }

    .ai-logo-section__tagline-{{ ai_gen_id }} {
      font-size: {{ block.settings.tagline_font_size | times: 0.9 | round }}px;
    }
  }
{% endstyle %}

<logo-section-{{ ai_gen_id }}
  class="ai-logo-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-logo-section__container-{{ ai_gen_id }}">
    {% if block.settings.logo_link != blank %}
      <a
        href="{{ block.settings.logo_link }}"
        class="ai-logo-section__link-{{ ai_gen_id }}"
        aria-label="Go to {{ block.settings.logo_link }}"
      >
    {% endif %}

    <div class="ai-logo-section__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 800 }}"
          alt="{{ block.settings.logo.alt | default: shop.name | escape }}"
          class="ai-logo-section__image-{{ ai_gen_id }}"
          width="{{ block.settings.logo.width }}"
          height="{{ block.settings.logo.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-logo-section__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <span class="ai-logo-section__placeholder-text-{{ ai_gen_id }}">
            Add your brand logo
          </span>
        </div>
      {% endif %}
    </div>

    {% if block.settings.logo_link != blank %}
      </a>
    {% endif %}

    {% if block.settings.tagline != blank %}
      <div class="ai-logo-section__tagline-{{ ai_gen_id }}">
        {{ block.settings.tagline }}
      </div>
    {% endif %}
  </div>
</logo-section-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('logo-section-{{ ai_gen_id }}', LogoSection{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Brand logo",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Desktop width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 190
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Mobile width",
      "min": 60,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Tagline"
    },
    {
      "type": "richtext",
      "id": "tagline",
      "label": "Tagline text"
    },
    {
      "type": "range",
      "id": "tagline_font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Color",
      "default": "#7A6A5C"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FBF6EC"
    }
  ],
  "presets": [
    {
      "name": "Brand logo"
    }
  ]
}
{% endschema %}
