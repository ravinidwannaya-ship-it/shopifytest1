{% doc %}
  @prompt
    Create a standalone logo section that displays the store logo centered on the page. It should have settings to upload a logo image, control the logo width/size, add padding above and below, and optionally link the logo to the homepage. The section should be clean, minimal, and work well on both desktop and mobile. On mobile, the logo should be responsive and scale appropriately.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-logo-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
    text-align: center;
  }

  .ai-logo-section__link-{{ ai_gen_id }} {
    display: inline-block;
    text-decoration: none;
  }

  .ai-logo-section__image-wrapper-{{ ai_gen_id }} {
    display: inline-block;
    max-width: 100%;
  }

  .ai-logo-section__image-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width_desktop }}px;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .ai-logo-section__placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width_desktop }}px;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .ai-logo-section__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: auto;
    opacity: 0.3;
  }

  .ai-logo-section__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    text-align: center;
    pointer-events: none;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-logo-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-logo-section__image-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
    }

    .ai-logo-section__placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-logo-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-section__container-{{ ai_gen_id }}">
    {% if block.settings.enable_link %}
      <a href="{{ block.settings.logo_link }}" class="ai-logo-section__link-{{ ai_gen_id }}" aria-label="Go to homepage">
        {% if block.settings.logo %}
          <div class="ai-logo-section__image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.logo | image_url: width: 800 }}"
              alt="{{ block.settings.logo.alt | default: shop.name | escape }}"
              class="ai-logo-section__image-{{ ai_gen_id }}"
              width="{{ block.settings.logo.width }}"
              height="{{ block.settings.logo.height }}"
              loading="lazy"
            >
          </div>
        {% else %}
          <div class="ai-logo-section__placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-logo-section__empty-state-{{ ai_gen_id }}">
              Upload your logo
            </div>
          </div>
        {% endif %}
      </a>
    {% else %}
      {% if block.settings.logo %}
        <div class="ai-logo-section__image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ block.settings.logo | image_url: width: 800 }}"
            alt="{{ block.settings.logo.alt | default: shop.name | escape }}"
            class="ai-logo-section__image-{{ ai_gen_id }}"
            width="{{ block.settings.logo.width }}"
            height="{{ block.settings.logo.height }}"
            loading="lazy"
          >
        </div>
      {% else %}
        <div class="ai-logo-section__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-logo-section__empty-state-{{ ai_gen_id }}">
            Upload your logo
          </div>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Logo section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width_desktop",
      "label": "Desktop width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 190
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Mobile width",
      "min": 60,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "checkbox",
      "id": "enable_link",
      "label": "Enable logo link",
      "default": true
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FBF6EC"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#7A6A5C"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container width",
      "min": 600,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    }
  ],
  "presets": [
    {
      "name": "Logo section"
    }
  ]
}
{% endschema %}
