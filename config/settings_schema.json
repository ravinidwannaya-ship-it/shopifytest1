      { "type": "checkbox", "id": "enable_animations", "label": "Animate sections on scroll", "default": true }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      { "type": "range", "id": "button_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Button corner radius", "default": 2 },
      { "type": "range", "id": "button_padding_y", "min": 8, "max": 24, "step": 1, "unit": "px", "label": "Button vertical padding", "default": 14 },
