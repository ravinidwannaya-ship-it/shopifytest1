      { "type": "color", "id": "color_success", "label": "Success / in stock", "default": "#2F6B45" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "assistant_n4" },
      { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "assistant_n4" },
      { "type": "header", "content": "Google fonts (optional, overrides above)" },
      { "type": "paragraph", "content": "Leave the family fields blank to use the Shopify fonts selected above." },
      { "type": "text", "id": "google_font_heading", "label": "Heading Google font family", "default": "Cormorant Garamond" },
      { "type": "text", "id": "google_font_body", "label": "Body Google font family", "default": "Karla" },
      { "type": "text", "id": "google_font_weights", "label": "Weights to load", "default": "300;400;500;600;700", "info": "Semicolon separated." },
      { "type": "header", "content": "Scale" },
      { "type": "range", "id": "heading_scale", "min": 80, "max": 140, "step": 5, "unit": "%", "label": "Heading size", "default": 100 },
      { "type": "range", "id": "body_scale", "min": 85, "max": 125, "step": 5, "unit": "%", "label": "Body size", "default": 100 },
      { "type": "select", "id": "heading_transform", "label": "Heading letter case", "default": "none", "options": [
