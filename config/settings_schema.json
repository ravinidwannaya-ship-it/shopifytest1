      { "type": "range", "id": "heading_letter_spacing", "min": -2, "max": 8, "step": 1, "unit": "px", "label": "Heading letter spacing", "default": 0 },
      { "type": "range", "id": "eyebrow_letter_spacing", "min": 0, "max": 10, "step": 1, "unit": "px", "label": "Eyebrow letter spacing", "default": 3 }
    ]
  },
  {
    "name": "Layout",
