  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "image_picker", "id": "logo_light", "label": "Logo for dark backgrounds (footer)" },
      { "type": "range", "id": "logo_width", "min": 70, "max": 360, "step": 5, "unit": "px", "label": "Logo width", "default": 160 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" },
      { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Kyathi Heritage" },
      { "type": "textarea", "id": "footer_tagline", "label": "Brand tagline", "default": "Gold coated silver idols and framed deity reliefs, hand-finished in Puttur, Karnataka." },
      { "type": "image_picker", "id": "social_share_image", "label": "Default social sharing image" }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      { "type": "select", "id": "card_image_ratio", "label": "Image ratio", "default": "portrait", "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "tall", "label": "Tall (2:3)" }
      ]},
      { "type": "checkbox", "id": "card_show_secondary_image", "label": "Show second image on hover", "default": true },
      { "type": "checkbox", "id": "card_show_vendor", "label": "Show vendor", "default": false },
      { "type": "checkbox", "id": "card_show_rating", "label": "Show rating (metafield reviews)", "default": true },
      { "type": "checkbox", "id": "card_show_quick_add", "label": "Show quick add button", "default": true },
      { "type": "checkbox", "id": "card_show_sale_badge", "label": "Show sale badge", "default": true },
      { "type": "checkbox", "id": "card_show_sold_out_badge", "label": "Show sold out badge", "default": true },
      { "type": "text", "id": "badge_new_tag", "label": "Tag that shows a \"New\" badge", "default": "new" },
