        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ]}
    ]
  },
  {
    "name": "Cart",
    "settings": [
      { "type": "select", "id": "cart_type", "label": "Cart behaviour", "default": "drawer", "options": [
