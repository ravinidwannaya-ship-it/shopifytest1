<div class="section text-center" style="padding-block:120px">
  <div class="container container--narrow">
    {%- if settings.logo -%}<img src="{{ settings.logo | image_url: width: 480 }}" alt="{{ shop.name }}" width="200" height="70" style="width:200px;margin:0 auto 24px">{%- endif -%}
    <h1>{{ shop.name }}</h1>
    <div class="rte">{{ shop.password_message }}</div>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password" aria-label="Password" style="max-width:320px;margin:0 auto">
      <button type="submit" class="btn" style="margin-top:10px">Enter</button>
    {% endform %}
  </div>
</div>
