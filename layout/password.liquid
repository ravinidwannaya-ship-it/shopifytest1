<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>:root{--bg:{{ settings.color_bg }};--text:{{ settings.color_text }};--primary:{{ settings.color_primary }};--accent:{{ settings.color_accent }};--card:{{ settings.color_card }};--border:{{ settings.color_border }};--page-width:{{ settings.page_width }}px;--radius:{{ settings.corner_radius }}px;--btn-radius:{{ settings.button_radius }}px;--btn-py:14px;--btn-px:26px}</style>
  </head>
  <body class="template-password">{{ content_for_layout }}</body>
</html>
