{%- if settings.show_mobile_bottom_nav -%}
<nav class="mobnav is-on" aria-label="Mobile">
  <a href="{{ routes.root_url }}"><span aria-hidden="true">&#8962;</span>Home</a>
  <a href="{{ routes.all_products_collection_url }}"><span aria-hidden="true">&#9776;</span>Shop</a>
  <a href="{{ routes.search_url }}"><span aria-hidden="true">&#9906;</span>Search</a>
  {%- if shop.customer_accounts_enabled -%}
    <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"><span aria-hidden="true">&#9787;</span>Account</a>
  {%- endif -%}
  <a href="{{ routes.cart_url }}"><span aria-hidden="true">&#128722;</span>Cart (<span data-cart-count>{{ cart.item_count }}</span>)</a>
</nav>
{%- endif -%}
