{%- if settings.cart_type == 'drawer' -%}
<div class="drawer drawer--right" id="CartDrawer" role="dialog" aria-modal="true" aria-label="Cart">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel">
    <div class="drawer__head">
      <h3 style="margin:0">Your cart</h3>
      <button class="drawer__close" type="button" data-drawer-close aria-label="Close cart">&times;</button>
    </div>
    <div data-cart-contents style="display:contents">
      {% render 'cart-drawer-contents' %}
    </div>
  </div>
</div>
{%- endif -%}
