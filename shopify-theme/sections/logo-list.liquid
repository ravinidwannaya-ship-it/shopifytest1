<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% endif %} text-center" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    {% render 'section-head' %}
    <div class="{% if section.settings.scroll %}marquee{% endif %}">
      <div class="{% if section.settings.scroll %}marquee__track{% else %}grid grid--{{ section.settings.columns }}{% endif %}" style="--cols-mobile:3;align-items:center">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }} style="opacity:.8">
            {%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 320 }}" alt="{{ block.settings.name | escape }}" width="160" height="60" loading="lazy" style="max-height:56px;width:auto;margin:0 auto;object-fit:contain">{%- else -%}<span>{{ block.settings.name }}</span>{%- endif -%}
          </div>
        {%- endfor -%}
        {%- if section.settings.scroll -%}
          {%- for block in section.blocks -%}
            <div aria-hidden="true" style="opacity:.8">{%- if block.settings.image -%}<img src="{{ block.settings.image | image_url: width: 320 }}" alt="" width="160" height="60" loading="lazy" style="max-height:56px;width:auto;object-fit:contain">{%- else -%}<span>{{ block.settings.name }}</span>{%- endif -%}</div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Logo list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Trusted by" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "min": 3, "max": 6, "step": 1, "label": "Columns", "default": 5 },
    { "type": "checkbox", "id": "scroll", "label": "Auto-scroll logos", "default": true },
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "default", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    { "type": "logo", "name": "Logo", "settings": [
      { "type": "image_picker", "id": "image", "label": "Logo" },
      { "type": "text", "id": "name", "label": "Name", "default": "Client" }
    ]}
  ],
  "presets": [{ "name": "Logo list", "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }] }]
}
{% endschema %}
