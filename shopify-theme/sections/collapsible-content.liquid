<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container container--narrow">
    {% render 'section-head' %}
    {%- for block in section.blocks -%}
      <details class="accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
        <summary>{{ block.settings.heading }}</summary>
        <div class="accordion__body rte">{{ block.settings.text }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "FAQ / Collapsible",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "default", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    { "type": "row", "name": "Question", "settings": [
      { "type": "text", "id": "heading", "label": "Question", "default": "Is the gold coating permanent?" },
      { "type": "richtext", "id": "text", "label": "Answer", "default": "<p>Yes. The 24K coating is electroplated and then anti-tarnish sealed.</p>" },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ]}
  ],
  "presets": [{ "name": "FAQ / Collapsible", "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }] }]
}
{% endschema %}
