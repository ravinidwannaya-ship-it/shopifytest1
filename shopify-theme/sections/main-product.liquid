<div class="section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    {%- if section.settings.show_breadcrumbs -%}
      <nav class="muted" style="font-size:.82rem;margin-bottom:18px" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a> / {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a> / {% endif %}<span>{{ product.title }}</span>
      </nav>
    {%- endif -%}
    <div class="product">
      <div data-gallery>
        <div class="gallery__main media {% if section.settings.gallery_ratio != 'adapt' %}ratio-{{ section.settings.gallery_ratio }}{% endif %}">
          {%- if product.featured_image -%}
            <img data-gallery-main src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1400" height="1750" fetchpriority="high">
          {%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="gallery__thumbs">
            {%- for image in product.images -%}
              <img data-thumb data-full="{{ image | image_url: width: 1400 }}" src="{{ image | image_url: width: 220 }}" alt="{{ product.title | escape }} view {{ forloop.index }}" loading="lazy" {% if forloop.first %}aria-current="true"{% endif %}>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__sticky">
        <div data-product-form>
        {%- form 'product', product, id: 'ProductForm' -%}
          <script type="application/json" data-variants>
            [{% for v in product.variants %}{"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price | money | json }},"price_raw":{{ v.price }},"compare_at":{{ v.compare_at_price | money | json }},"compare_at_raw":{{ v.compare_at_price | default: 0 }},"available":{{ v.available }},"inventory":{{ v.inventory_quantity | default: 0 }},"image":{% if v.image %}{{ v.image | image_url: width: 1400 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
          </script>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'vendor' -%}
                <p class="eyebrow" {{ block.shopify_attributes }}>{{ product.type | default: product.vendor | default: settings.brand_name }}</p>
              {%- when 'title' -%}
                <h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>
              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  {%- assign r = product.metafields.reviews.rating.value.rating | round -%}
                  <div class="stars" {{ block.shopify_attributes }}>{% for i in (1..5) %}{% if i <= r %}&#9733;{% else %}&#9734;{% endif %}{% endfor %} <span class="muted" style="font-size:.85rem">{{ product.metafields.reviews.rating_count }} reviews</span></div>
                {%- endif -%}
              {%- when 'price' -%}
                <p class="price price--lg" {{ block.shopify_attributes }}><span data-price>{{ product.price | money }}</span><s data-compare>{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money }}{% endif %}</s></p>
                {%- if block.settings.show_tax_note -%}<p class="muted" style="font-size:.8rem;margin-top:-6px">{{ block.settings.tax_note }}</p>{%- endif -%}
              {%- when 'inventory' -%}
                <p class="muted" data-stock {{ block.shopify_attributes }}>{% if product.selected_or_first_available_variant.available %}In stock{% else %}Sold out{% endif %}</p>
              {%- when 'short_description' -%}
                <div class="rte muted" {{ block.shopify_attributes }}>{{ block.settings.text | default: product.description | strip_html | truncate: 220 }}</div>
              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- if block.settings.style == 'buttons' -%}
                      <div class="field" data-option><span>{{ option.name }}</span>
                        <div class="swatches">
                          {%- for value in option.values -%}
                            <button type="button" class="swatch" data-value="{{ value | escape }}" aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value }}</button>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- else -%}
                      <label class="field"><span>{{ option.name }}</span>
                        <select data-option>
                          {%- for value in option.values -%}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>{%- endfor -%}
                        </select>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                  </div>
                {%- endunless -%}
              {%- when 'quantity' -%}
                <div class="field" {{ block.shopify_attributes }}><span>Quantity</span>
                  <div class="qty"><button type="button" data-qty="down" aria-label="Decrease">&minus;</button><input type="number" name="quantity" value="1" min="1" aria-label="Quantity"><button type="button" data-qty="up" aria-label="Increase">+</button></div>
                </div>
              {%- when 'buy_buttons' -%}
                <div data-buy-anchor {{ block.shopify_attributes }}>
                  <button type="submit" name="add" class="btn btn--full" data-add {% unless product.available %}disabled{% endunless %}>{% if product.available %}{{ block.settings.label }}{% else %}Sold out{% endif %}</button>
                  {%- if block.settings.show_dynamic -%}<div style="margin-top:8px">{{ form | payment_button }}</div>{%- endif -%}
                </div>
              {%- when 'whatsapp' -%}
                {%- if settings.whatsapp != blank -%}
                  <a class="btn btn--outline btn--full" style="margin-top:10px" target="_blank" rel="noopener" {{ block.shopify_attributes }}
                     href="https://wa.me/{{ settings.whatsapp }}?text={{ block.settings.message | append: ' ' | append: product.title | append: ' - ' | append: shop.url | append: product.url | url_encode }}">{{ block.settings.label }}</a>
                {%- endif -%}
              {%- when 'pickup' -%}
                <div class="card" style="padding:14px;margin-top:14px" {{ block.shopify_attributes }}>
                  <strong>{{ block.settings.heading }}</strong>
                  <div class="muted" style="font-size:.9rem">{{ settings.address }}<br>{{ settings.hours }}</div>
                </div>
              {%- when 'trust_icons' -%}
                <div class="trust" style="margin-top:18px" {{ block.shopify_attributes }}>
                  <div class="trust__item"><div class="trust__icon">{{ block.settings.icon_1 }}</div><small>{{ block.settings.text_1 }}</small></div>
                  <div class="trust__item"><div class="trust__icon">{{ block.settings.icon_2 }}</div><small>{{ block.settings.text_2 }}</small></div>
                  <div class="trust__item"><div class="trust__icon">{{ block.settings.icon_3 }}</div><small>{{ block.settings.text_3 }}</small></div>
                  <div class="trust__item"><div class="trust__icon">{{ block.settings.icon_4 }}</div><small>{{ block.settings.text_4 }}</small></div>
                </div>
              {%- when 'description' -%}
                <details class="accordion" open {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="accordion__body rte">{{ product.description }}</div></details>
              {%- when 'accordion' -%}
                <details class="accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="accordion__body rte">{{ block.settings.text }}{% if block.settings.page != blank %}{{ pages[block.settings.page].content }}{% endif %}</div></details>
              {%- when 'specs' -%}
                <details class="accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary>
                  <div class="accordion__body">
                    <table class="spec-table"><tbody>
                      {%- if product.metafields.custom.specifications.value != blank -%}
                        {{ product.metafields.custom.specifications.value }}
                      {%- else -%}
                        {%- assign rows = block.settings.rows | newline_to_br | split: '<br />' -%}
                        {%- for row in rows -%}{%- assign kv = row | split: ':' -%}
                          {%- if kv.size > 1 -%}<tr><td>{{ kv[0] | strip }}</td><td>{{ kv[1] | strip }}</td></tr>{%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                    </tbody></table>
                  </div>
                </details>
              {%- when 'share' -%}
                <div style="margin-top:14px;display:flex;gap:12px;align-items:center" {{ block.shopify_attributes }}>
                  <span class="muted" style="font-size:.85rem">Share</span>
                  <a href="https://wa.me/?text={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
                  <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener">Facebook</a>
                  <a href="https://pinterest.com/pin/create/button/?url={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener">Pinterest</a>
                  <a href="mailto:?subject={{ product.title | url_encode }}&body={{ shop.url | append: product.url | url_encode }}">Email</a>
                </div>
              {%- when 'custom_liquid' -%}
                <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.show_sticky_bar -%}
<div class="sticky-buy">
  <div style="flex:0 0 auto"><strong class="price">{{ product.price | money }}</strong></div>
  <button type="submit" form="ProductForm" class="btn" {% unless product.available %}disabled{% endunless %}>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</button>
</div>
{%- endif -%}

<script type="application/ld+json">
{{ product | structured_data }}
</script>
{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "checkbox", "id": "show_sticky_bar", "label": "Show sticky add-to-cart bar on mobile", "default": true },
    { "type": "select", "id": "gallery_ratio", "label": "Main image ratio", "default": "portrait", "options": [
      { "value": "adapt", "label": "Adapt" }, { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    { "type": "vendor", "name": "Eyebrow / type", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "rating", "name": "Rating", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_tax_note", "label": "Show tax note", "default": true },
      { "type": "text", "id": "tax_note", "label": "Tax note", "default": "Inclusive of all taxes. Shipping calculated at checkout." }
    ]},
    { "type": "inventory", "name": "Stock status", "limit": 1 },
    { "type": "short_description", "name": "Short description", "limit": 1, "settings": [
      { "type": "richtext", "id": "text", "label": "Override text" }
    ]},
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [
      { "type": "select", "id": "style", "label": "Style", "default": "buttons", "options": [
        { "value": "buttons", "label": "Buttons" }, { "value": "dropdown", "label": "Dropdowns" }
      ]}
    ]},
    { "type": "quantity", "name": "Quantity selector", "limit": 1 },
    { "type": "buy_buttons", "name": "Buy buttons", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Add to cart label", "default": "Add to cart" },
      { "type": "checkbox", "id": "show_dynamic", "label": "Show dynamic checkout button", "default": true }
    ]},
    { "type": "whatsapp", "name": "WhatsApp enquiry", "limit": 1, "settings": [
      { "type": "text", "id": "label", "label": "Button label", "default": "Enquire on WhatsApp" },
      { "type": "text", "id": "message", "label": "Message prefix", "default": "Hello, I am interested in" }
    ]},
    { "type": "pickup", "name": "Studio pickup", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Available for pickup at our studio" }
    ]},
    { "type": "trust_icons", "name": "Trust icons", "limit": 1, "settings": [
      { "type": "text", "id": "icon_1", "label": "Icon 1", "default": "*" },
      { "type": "text", "id": "text_1", "label": "Text 1", "default": "Hallmarked silver" },
      { "type": "text", "id": "icon_2", "label": "Icon 2", "default": "*" },
      { "type": "text", "id": "text_2", "label": "Text 2", "default": "Insured shipping" },
      { "type": "text", "id": "icon_3", "label": "Icon 3", "default": "*" },
      { "type": "text", "id": "text_3", "label": "Text 3", "default": "Gift packaging" },
      { "type": "text", "id": "icon_4", "label": "Icon 4", "default": "*" },
      { "type": "text", "id": "text_4", "label": "Text 4", "default": "Certificate included" }
    ]},
    { "type": "description", "name": "Description", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Description" }
    ]},
    { "type": "specs", "name": "Specifications", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
      { "type": "textarea", "id": "rows", "label": "Rows (one per line, Label: Value)", "default": "Metal: 999 fine silver\nCoating: 24K gold electroplating\nBase: Integrated, felt lined\nCare: Dry cloth only" }
    ]},
    { "type": "accordion", "name": "Accordion row", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Insured dispatch within 3 working days.</p>" },
      { "type": "page", "id": "page", "label": "Or pull content from a page" }
    ]},
    { "type": "share", "name": "Share buttons", "limit": 1 },
    { "type": "custom_liquid", "name": "Custom Liquid", "settings": [
      { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" }
    ]},
    { "type": "@app" }
  ]
}
{% endschema %}
