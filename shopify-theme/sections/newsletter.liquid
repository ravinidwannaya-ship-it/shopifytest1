<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% elsif section.settings.color_scheme == 'primary' %}section--primary{% endif %} text-center" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container container--narrow reveal">
    {% render 'section-head' %}
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required aria-label="Email address" style="max-width:340px">
        <button type="submit" class="btn btn--accent">{{ section.settings.button_label }}</button>
      </div>
      {%- if form.posted_successfully? -%}<p style="margin-top:12px">{{ section.settings.success_text }}</p>{%- endif -%}
    {% endform %}
  </div>
</div>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Festival drops, first look" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Limited runs sell out before they reach the shelf.</p>" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thank you. Please confirm from your inbox." },
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "primary", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }, { "value": "primary", "label": "Primary" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
