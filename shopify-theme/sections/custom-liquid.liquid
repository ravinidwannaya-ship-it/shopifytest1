<div class="section" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="{% if section.settings.full_width %}container--full{% else %}container{% endif %}">{{ section.settings.custom_liquid }}</div>
</div>
{% schema %}
{
  "name": "Custom Liquid / HTML",
  "settings": [
    { "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid", "default": "<p>Add any HTML, Liquid or app embed here.</p>" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "presets": [{ "name": "Custom Liquid / HTML" }]
}
{% endschema %}
