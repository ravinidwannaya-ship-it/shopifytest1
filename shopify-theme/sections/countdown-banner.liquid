<div class="section section--primary text-center" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;{% if section.settings.image %}background-image:linear-gradient(rgba(20,12,8,{{ section.settings.overlay_opacity | divided_by: 100.0 }}),rgba(20,12,8,{{ section.settings.overlay_opacity | divided_by: 100.0 }})),url({{ section.settings.image | image_url: width: 2000 }});background-size:cover;background-position:center{% endif %}">
  <div class="container container--narrow reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.end_date != blank -%}
      <div class="countdown" style="justify-content:center" data-countdown="{{ section.settings.end_date }}"></div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--accent" style="margin-top:20px" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Countdown banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 60 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Deepavali dispatch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order before the festival cut-off" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Custom idols need 21 days. Place your order in time.</p>" },
    { "type": "text", "id": "end_date", "label": "End date", "info": "Format: 2026-11-08T20:00:00", "default": "2026-11-08T20:00:00" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start a custom order" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "presets": [{ "name": "Countdown banner" }]
}
{% endschema %}
