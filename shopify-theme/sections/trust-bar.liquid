<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% elsif section.settings.color_scheme == 'primary' %}section--primary{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    <div class="trust">
      {%- for block in section.blocks -%}
        <div class="trust__item reveal" {{ block.shopify_attributes }}>
          <div class="trust__icon">{% if block.settings.image %}<img src="{{ block.settings.image | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy" style="margin:0 auto 6px">{% else %}{{ block.settings.icon }}{% endif %}</div>
          <strong>{{ block.settings.heading }}</strong>
          <div class="muted" style="font-size:.88rem">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Trust bar",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "alt", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }, { "value": "primary", "label": "Primary" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "*" },
      { "type": "image_picker", "id": "image", "label": "Icon image (optional)" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "999 silver, hallmarked" },
      { "type": "text", "id": "text", "label": "Text", "default": "Purity certificate with every idol." }
    ]}
  ],
  "presets": [{ "name": "Trust bar", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
