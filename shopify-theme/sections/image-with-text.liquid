<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% elsif section.settings.color_scheme == 'primary' %}section--primary{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    <div class="iwt iwt--{{ section.settings.image_position }} reveal">
      <div class="media ratio-{{ section.settings.ratio }}">
        {%- if section.settings.image -%}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" width="1200" height="1500" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
      </div>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
        <div class="rte">{{ section.settings.text }}</div>
        {%- for block in section.blocks -%}
          <div style="display:flex;gap:12px;margin-bottom:12px" {{ block.shopify_attributes }}>
            <span style="color:var(--accent);font-size:1.3rem">{{ block.settings.icon | default: '&#10022;' }}</span>
            <div><strong>{{ block.settings.heading }}</strong><div class="muted" style="font-size:.92rem">{{ block.settings.text }}</div></div>
          </div>
        {%- endfor -%}
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ]},
    { "type": "select", "id": "ratio", "label": "Image ratio", "default": "portrait", "options": [
      { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }
    ]},
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cast, chased and coated by hand" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every idol is cast in 999 silver, hand-chased, then coated in 24K gold and sealed against tarnish.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "default", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }, { "value": "primary", "label": "Primary" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    { "type": "point", "name": "Highlight", "settings": [
      { "type": "text", "id": "icon", "label": "Icon (emoji or symbol)", "default": "*" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Hallmarked purity" },
      { "type": "text", "id": "text", "label": "Text", "default": "Certificate included with every piece." }
    ]}
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
