<div class="section {% if section.settings.color_scheme == 'alt' %}section--alt{% endif %} {% if section.settings.text_align == 'center' %}text-center{% endif %}" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="container">
    {% render 'section-head' %}
    <div class="grid grid--{{ section.settings.columns }}" style="--cols-mobile:1">
      {%- for block in section.blocks -%}
        <div class="reveal {% if section.settings.card_style %}card{% endif %}" {% if section.settings.card_style %}style="padding:22px"{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            <div class="media ratio-landscape" style="margin-bottom:14px"><img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.heading | escape }}" width="800" height="450" loading="lazy"></div>
          {%- elsif block.settings.number != blank -%}
            <div class="step"><span class="step__n">{{ block.settings.number }}</span></div>
          {%- endif -%}
          <h3>{{ block.settings.heading }}</h3>
          <div class="rte muted">{{ block.settings.text }}</div>
          {%- if block.settings.link_label != blank -%}<a class="link-underline" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Multi-column",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How a Kyathi idol is made" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns", "default": 4 },
    { "type": "checkbox", "id": "card_style", "label": "Show as cards", "default": false },
    { "type": "select", "id": "color_scheme", "label": "Background", "default": "default", "options": [
      { "value": "default", "label": "Page background" }, { "value": "alt", "label": "Alternate" }
    ]},
    { "type": "select", "id": "text_align", "label": "Alignment", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }
    ]},
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "blocks": [
    { "type": "column", "name": "Column", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "number", "label": "Step number (used when no image)", "default": "01" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "Wax and mould" },
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The form is sculpted in wax and approved before casting.</p>" },
      { "type": "text", "id": "link_label", "label": "Link label" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Multi-column", "blocks": [{ "type": "column" }, { "type": "column" }, { "type": "column" }, { "type": "column" }] }]
}
{% endschema %}
