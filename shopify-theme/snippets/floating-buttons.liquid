<div class="fab-stack">
  {%- if settings.show_back_to_top -%}
    <button type="button" class="fab fab--top" data-back-to-top aria-label="Back to top">&#8593;</button>
  {%- endif -%}
  {%- if settings.show_call_fab and settings.phone != blank -%}
    <a class="fab fab--call" href="tel:{{ settings.phone | remove: ' ' }}" aria-label="Call {{ settings.phone }}">&#9742;</a>
  {%- endif -%}
  {%- if settings.show_whatsapp_fab and settings.whatsapp != blank -%}
    <a class="fab fab--wa" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"
       href="https://wa.me/{{ settings.whatsapp }}?text={{ settings.whatsapp_message | url_encode }}">&#9993;</a>
  {%- endif -%}
</div>
